# Server Configuration
PORT=5000

# Authentication Secrets
# JWT_SECRET: Required minimum 32 characters (256-bit). Server strictly fails startup if missing or shorter.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_random_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dbms_studio
DB_SSL=false

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Frontend API URL (leave blank if deploying backend + frontend together)
# VITE_API_BASE_URL=https://your-backend-domain.com
