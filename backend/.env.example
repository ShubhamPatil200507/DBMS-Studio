# Server Configuration
PORT=5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=dbms_studio
DB_SSL=false

# Dedicated Benchmark Database Configuration (Must be distinct from DB_NAME)
# Dedicated benchmark credentials are required by default; silent fallback to application credentials is prohibited.
BENCHMARK_DB_NAME=dbms_studio_benchmark
BENCHMARK_DB_USER=bench_user
BENCHMARK_DB_PASSWORD=bench_password_secret

# Authentication Secrets
# JWT_SECRET: Required minimum 32 characters (256-bit). Server strictly fails startup if missing or shorter.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_random_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
